{
  "name": "@hallaco/ui",
  "version": "0.2.0",
  "description": "Reusable accessible UI components and design primitives for Halla products.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jacksonpirlo/hallaui.git"
  },
  "bugs": {
    "url": "https://github.com/Jacksonpirlo/hallaui/issues"
  },
  "homepage": "https://github.com/Jacksonpirlo/hallaui#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "ci": "npm run build",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
